# reader-mlflow:local (SRV-OBS FR-OBS-8): the pinned MLflow image plus a data directory owned by the non-root uid,
# so a fresh named volume is writable under read_only and cap_drop ALL (measured in spikes/obs-stack). The store is
# SQLite (ADR-0032), so no database driver is added. FR-OBS-12 (c): MLflow's bundled model catalog is replaced by one
# all-zero file (generated by deploy/otel/mlflow_catalog.py), so MLflow never prices a span itself, with or without a
# provider key (measured in spikes/obs-stack round 5, stack E); the ledger's cost on `agent.call` is the only cost.
FROM ghcr.io/mlflow/mlflow:v3.18.0@sha256:257204c77980b0f3450a26eb6089e487603fcdd4509529eadaf88f90669f5c13
COPY deploy/otel/mlflow-catalog/anthropic.json /tmp/reader-catalog.json
RUN P=/usr/local/lib/python3.11/site-packages/mlflow/utils/model_catalog \
    && rm -f "$P"/*.json && cp /tmp/reader-catalog.json "$P/anthropic.json" && rm /tmp/reader-catalog.json \
    && mkdir -p /var/lib/mlflow && chown 10004:10004 /var/lib/mlflow
USER 10004
