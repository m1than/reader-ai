    "neutral": { "$type": "color", "$value": "#a9a499" },
    "success": { "$type": "color", "$value": "#8fc49d" },
    "warning": { "$type": "color", "$value": "#d9b26a" },
    "danger": { "$type": "color", "$value": "#e39a92" },
    "info": { "$type": "color", "$value": "#93b6d6" },
