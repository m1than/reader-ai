    "border": { "$type": "color", "$value": "#e2ded5" },
    "control-border": { "$type": "color", "$value": "#858074" },
    "accent": { "$type": "color", "$value": "#3d6b6e" },
    "on-tone": { "$type": "color", "$value": "#ffffff" },
    "neutral": { "$type": "color", "$value": "#5e5a52" },
    "success": { "$type": "color", "$value": "#2f6b43" },
    "warning": { "$type": "color", "$value": "#85560f" },
