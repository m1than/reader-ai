#!/usr/bin/env python3
"""Stub of the Claude Code CLI for the no-spend dry run of paid.py (dry_run.sh): speaks the SDK's stream-json
protocol on stdin/stdout, never touches the network, and checks what the real CLI would receive.

- Refuses (exit 7) any argv entry of 131,072 bytes or more (Linux MAX_ARG_STRLEN), a missing
  --system-prompt-file and a missing --no-session-persistence.
- STUB_HOME_BYTES=n leaves n bytes in $HOME per call, as a transcript would (tests the home-tmpfs check).
- Prompt caching like the API: the first call with a given system file writes it, later calls read it
  (STUB_NOCACHE=1: every call writes). Tokens = bytes / 3. Cost per call: STUB_USD.
- Answers: a judge-shaped JSON for judge prompts, a short Russian line otherwise; STUB_EMPTY=1 answers "".
"""

import hashlib
import json
import os
import sys
from pathlib import Path

LIMIT = 131072
args = sys.argv[1:]
if any(len(a.encode()) >= LIMIT for a in args):
    print("stub: argument over MAX_ARG_STRLEN", file=sys.stderr)
    sys.exit(7)
if "--no-session-persistence" not in args:
    print("stub: a call must pass --no-session-persistence (the real CLI writes a transcript per call)", file=sys.stderr)
    sys.exit(7)
if os.environ.get("STUB_HOME_BYTES"):  # simulate files the CLI leaves in HOME, for the home-tmpfs check
    leftovers = Path(os.environ["HOME"]) / ".stub"
    leftovers.mkdir(exist_ok=True)
    (leftovers / os.urandom(8).hex()).write_bytes(b"x" * int(os.environ["STUB_HOME_BYTES"]))
if "--system-prompt" in args or "--system-prompt-file" not in args:
    print("stub: the system prompt must come as a file", file=sys.stderr)
    sys.exit(7)
system = Path(args[args.index("--system-prompt-file") + 1])
if not system.is_file():
    print("stub: system prompt file missing", file=sys.stderr)
    sys.exit(7)
size = len(system.read_bytes()) // 3
state = Path("/tmp/stubcache") / hashlib.sha256(str(system).encode()).hexdigest()
state.parent.mkdir(exist_ok=True)
hit = (state.exists() or os.environ.get("STUB_PREWARM") == "1") and os.environ.get("STUB_NOCACHE") != "1"
first = not state.exists()   # the first call with this system file in the run
state.touch()
# STUB_CONTINUE_FIRST=k: the CLI continued that first call to k requests; usage is summed, so a cold first call
# writes the context once and reads it k-1 times, a warm one (STUB_PREWARM=1, still cached) reads it k times
k = int(os.environ.get("STUB_CONTINUE_FIRST") or 1) if first else 1


def send(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


for line in sys.stdin:
    msg = json.loads(line)
    if msg.get("type") == "control_request":
        send({"type": "control_response",
              "response": {"subtype": "success", "request_id": msg["request_id"], "response": {}}})
    elif msg.get("type") == "user":
        content = msg["message"]["content"]
        prompt = content if isinstance(content, str) else json.dumps(content, ensure_ascii=False)
        span = prompt.split("<chunk>\n", 1)[-1].split("\n</chunk>", 1)[0] if "<chunk>" in prompt else None
        # STUB_FAIL_SHA: comma-separated sha256 prefixes (16 hex) of the span texts whose calls always fail
        fail_set = set(filter(None, os.environ.get("STUB_FAIL_SHA", "").split(",")))
        fail = span is not None and hashlib.sha256(span.encode()).hexdigest()[:16] in fail_set
        # STUB_ANSWER_TOKENS=n: summary answers are n tokens long; above the output cap the real CLI continues the
        # call to 4 requests (4 x cap output tokens) and fails it (summaries run 1: 18 of 23 at a 200 cap)
        cap = int(os.environ.get("CLAUDE_CODE_MAX_OUTPUT_TOKENS") or 32000)
        answer = int(os.environ.get("STUB_ANSWER_TOKENS") or 0)
        if "<section>" in prompt and answer > cap:
            send({"type": "assistant", "message": {"role": "assistant", "model": "stub", "content": [
                {"type": "text", "text": "stub: output token maximum exceeded"}]},
                  "parent_tool_use_id": None, "session_id": "stub"})
            send({"type": "result", "subtype": "error_max_turns", "duration_ms": 1, "duration_api_ms": 1,
                  "is_error": True, "num_turns": 1, "session_id": "stub",
                  "total_cost_usd": float(os.environ.get("STUB_USD", "0.0004")),
                  "usage": {"input_tokens": 8, "output_tokens": 4 * cap, "cache_creation_input_tokens": size,
                            "cache_read_input_tokens": 0}, "result": ""})
            break
        if fail:  # like run 1's 54 failures: a billed call that ends in an error result without an answer
            send({"type": "result", "subtype": "error_max_turns", "duration_ms": 1, "duration_api_ms": 1,
                  "is_error": True, "num_turns": 1, "session_id": "stub",
                  "total_cost_usd": float(os.environ.get("STUB_USD", "0.0004")),
                  "usage": {"input_tokens": 2, "output_tokens": 1200, "cache_creation_input_tokens": 0,
                            "cache_read_input_tokens": 4 * size}, "result": ""})
            break
        if os.environ.get("STUB_EMPTY") == "1":
            text = ""
        elif "expected_facts" in prompt:
            text = '{"sufficient": true, "facts_present": [0], "claim": "holds"}'
        else:
            text = "контекст фрагмента"
        usage = {"input_tokens": len(prompt.encode()) // 3, "output_tokens": 20,
                 "cache_creation_input_tokens": 0 if hit else size, "cache_read_input_tokens": size if hit else 0,
                 "cache_creation": {"ephemeral_1h_input_tokens": 0 if hit else size, "ephemeral_5m_input_tokens": 0}}
        if k > 1:
            usage["cache_read_input_tokens"] = (k if hit else k - 1) * size
            usage["output_tokens"] = 300 * (k - 1) + 74
        send({"type": "assistant", "message": {"role": "assistant", "model": "stub",
                                                "content": [{"type": "text", "text": text}]},
              "parent_tool_use_id": None, "session_id": "stub"})
        send({"type": "result", "subtype": "success", "duration_ms": 1, "duration_api_ms": 1, "is_error": False,
              "num_turns": 1, "session_id": "stub", "total_cost_usd": float(os.environ.get("STUB_USD", "0.0004")),
              "usage": usage, "result": text})
        break
