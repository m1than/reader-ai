(version 1)
; SRV-INGEST FR-INGEST-4: the converter's profile, the measured spikes/ingest-confine/converter.sb without its
; SCRIPTS parameter (the converter's code is read from the non-editable install inside VENV).
; Parameters (realpaths, passed with -D): PYROOT (the CPython install the venv links to), VENV, MODELS,
; WORK (the only writable tree; also the cwd).
; No mach-lookup, iokit-open, network, ipc-posix or signal rule: all of them stay denied.
(deny default)

; Program and runtime: read and map, never write.
(allow file-read* file-map-executable
  (subpath (param "PYROOT"))
  (subpath (param "VENV"))
  (subpath "/usr/lib")
  (subpath "/System/Library")
  (subpath "/System/Cryptexes")
  (subpath "/private/var/db/dyld"))
(allow file-read* (subpath (param "MODELS")))
(allow file-read* (literal "/dev/urandom") (literal "/dev/null"))
(allow file-read* (literal "/"))                                ; added: dyld aborts in CacheFinder without it
(allow file-read* (literal "/private/etc/apache2/mime.types"))  ; added: stdlib mimetypes opens it on import
(allow file-read-metadata)

; The only writable tree.
(allow file-read* file-write* (subpath (param "WORK")))
(allow file-write-data (literal "/dev/null"))

; Processes: the venv python (a symlink) and the interpreter it resolves to; nothing else can be executed.
(allow process-exec
  (literal (string-append (param "VENV") "/bin/python"))
  (literal (string-append (param "PYROOT") "/bin/python3.14")))   ; added: exec checks the resolved target
(allow process-fork)

; Edits of spikes/ingest-sysctl (2026-11-23; ADR-0029 Decision 3), listed in spec/fixtures/SRV-INGEST/profile-edits.sb.
; With an unrestricted (allow sysctl-read) and no process-info rule, a confined child read every same-uid process's
; arguments and environment (kern.procargs2) and cwd (proc_pidinfo). Both edits are needed: either alone, or a deny
; by sysctl name, leaves kern.procargs2 of another pid readable (measured).
; 1. sysctl: hardware, VM and OS identity only; nothing under kern.proc or kern.procargs. kern.hostname stays:
;    os.uname() needs it, and `import ctypes` calls os.uname().
(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name-prefix "machdep.")
  (sysctl-name-prefix "vm.")
  (sysctl-name-prefix "sysctl.")
  (sysctl-name-prefix "security.mac.")
  (sysctl-name-prefix "kern.os")
  (sysctl-name "kern.version")
  (sysctl-name "kern.iossupportversion")   ; seen requested by the runtime; an OS-identity string
  (sysctl-name "kern.hostname")            ; residual: the child can read the Mac's host name
  (sysctl-name "kern.boottime")
  (sysctl-name "kern.argmax")
  (sysctl-name "kern.maxfiles")
  (sysctl-name "kern.maxfilesperproc")
  (sysctl-name "kern.ngroups")
  (sysctl-name "kern.secure_kernel")
  (sysctl-name "kern.usrstack64")
  (sysctl-name "kern.clockrate")
  (sysctl-name "kern.hv_vmm_present")
  (sysctl-name "kern.willshutdown")
  (sysctl-name "kern.memorystatus_level"))
; 2. process-info: the process itself only (no proc_pidinfo, proc_pidpath or proc_listpids of another process).
(deny process-info*)
(allow process-info* (target self))
