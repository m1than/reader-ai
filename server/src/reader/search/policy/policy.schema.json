{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/search/policy.schema.json",
  "title": "SRV-SEARCH FR-SEARCH-34 retrieval policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "channels", "routes", "question_rules", "card_budgets", "candidates_max", "expand_cap",
    "expand_per_card", "expand_decay", "preselect_factor", "objective", "same_point_tau", "gate", "judge",
    "thresholds", "rrf_k", "w_dense", "k_max", "budget_min", "open_depth_max", "quote_max_chars",
    "quotes_per_card_max", "walk_quote_fraction_max", "owner_judge_run_cap_usd"],
  "properties": {
    "version": {"const": 1},
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp", "owner", "tutor", "pipeline"],
      "properties": {
        "mcp": {"$ref": "#/$defs/channel"},
        "owner": {"$ref": "#/$defs/channel"},
        "tutor": {"$ref": "#/$defs/channel"},
        "pipeline": {"$ref": "#/$defs/channel"}
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(mcp|owner|tutor|pipeline)\\.(exact|thematic|current_state|fact_check)$": {"$ref": "#/$defs/route"}
      }
    },
    "question_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "current_state"],
      "properties": {
        "identifier": {"$ref": "#/$defs/patterns"},
        "current_state": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {"^[a-z]{2}$": {"$ref": "#/$defs/patterns"}}
        }
      }
    },
    "card_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2"],
      "properties": {
        "L0": {"$ref": "#/$defs/tokens"},
        "L1": {"$ref": "#/$defs/tokens"},
        "L2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaf", "chapter", "root"],
          "properties": {
            "leaf": {"$ref": "#/$defs/tokens"},
            "chapter": {"$ref": "#/$defs/tokens"},
            "root": {"$ref": "#/$defs/tokens"}
          }
        }
      }
    },
    "candidates_max": {"type": "integer", "minimum": 1, "maximum": 50},
    "expand_cap": {"type": "integer", "minimum": 1, "maximum": 50},
    "expand_per_card": {"type": "integer", "minimum": 0, "maximum": 2},
    "expand_decay": {"type": "number", "minimum": 0, "maximum": 1},
    "preselect_factor": {"type": "number", "minimum": 1, "maximum": 4},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier_weight", "lexeme_weight", "relevance_weight"],
      "properties": {
        "identifier_weight": {"type": "number", "minimum": 0, "maximum": 100},
        "lexeme_weight": {"type": "number", "minimum": 0, "maximum": 100},
        "relevance_weight": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "same_point_tau": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "margin"],
      "properties": {
        "mode": {"enum": ["never_judge", "always_judge", "margin"]},
        "margin": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "if": {"properties": {"mode": {"const": "margin"}}},
      "then": {"properties": {"margin": {"type": "number"}}}
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_s", "input_cap_tokens"],
      "properties": {
        "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 8.0},
        "input_cap_tokens": {"type": "integer", "minimum": 1, "maximum": 3000}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judge.find.sufficiency_threshold", "judge.eval.relevance.pass_threshold",
        "judge.eval.sufficiency.pass_threshold", "judge.eval.groundedness.pass_threshold",
        "judge.eval.self_contained.pass_threshold", "judge.eval.citation_supports_claim.pass_threshold"],
      "patternProperties": {
        "^judge\\.(find\\.sufficiency_threshold|eval\\.[a-z_]+\\.pass_threshold)$": {
          "type": "number", "minimum": 0, "maximum": 1
        }
      }
    },
    "rrf_k": {"type": "integer", "minimum": 1, "maximum": 1000},
    "w_dense": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
    "k_max": {"type": "integer", "minimum": 1, "maximum": 50},
    "budget_min": {"$ref": "#/$defs/tokens"},
    "open_depth_max": {"type": "integer", "minimum": 1, "maximum": 8},
    "quote_max_chars": {"type": "integer", "minimum": 1, "maximum": 300},
    "quotes_per_card_max": {"type": "integer", "minimum": 0, "maximum": 8},
    "walk_quote_fraction_max": {"type": "number", "minimum": 0, "maximum": 1},
    "owner_judge_run_cap_usd": {"type": "number", "minimum": 0.002, "maximum": 1}
  },
  "$defs": {
    "tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_default", "budget_max"],
      "properties": {
        "budget_default": {"$ref": "#/$defs/tokens"},
        "budget_max": {"$ref": "#/$defs/tokens"}
      }
    },
    "patterns": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 50},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "filters", "rrf"],
      "properties": {
        "layers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["L0", "L1", "L2", "L3", "L4"]}
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "form", "reliability_min", "newest_as_of"],
          "properties": {
            "role": {"type": ["string", "null"]},
            "form": {"type": ["string", "null"]},
            "reliability_min": {"type": ["string", "null"]},
            "newest_as_of": {"type": "boolean"}
          }
        },
        "rrf": {"type": "boolean"},
        "l5_boost": {"type": "boolean"}
      }
    }
  }
}
