{
  "permissions": {
    "allow": [
      "Bash(bash e2e/live/stage-1.sh *)",
      "Bash(bash e2e/live/verify-all.sh *)",
      "Bash(bash e2e/live/verify-all.sh)"
    ],
    "deny": [
      "Read(~/Developer/.token_tg_bot)",
      "Read(~/.config/reader-ai/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(export -p)",
      "Bash(set)",
      "Bash(*token_tg_bot*)",
      "Bash(*CLAUDE_CODE_OAUTH_TOKEN*)",
      "Bash(security find-generic-password *)",
      "Bash(security dump-keychain *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(npm publish *)",
      "Bash(gh release create *)",
      "Bash(docker exec *)",
      "Bash(docker container exec *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose * exec *)",
      "Bash(docker run *--pid*)",
      "Bash(docker container run *--pid*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/pre-write.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent/notify.mjs\" --hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent/notify.mjs\" --hook"
          }
        ]
      }
    ]
  }
}
